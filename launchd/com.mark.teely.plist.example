<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
  <dict>
    <key>Label</key>
    <string>com.marksowell.teely</string>

    <key>ProgramArguments</key>
    <array>
      <string>/absolute/path/to/teely/teely</string>
      <string>-config</string>
      <string>/absolute/path/to/teely/teely.local.json</string>
    </array>

    <key>RunAtLoad</key>
    <true/>

    <key>KeepAlive</key>
    <true/>

    <key>WorkingDirectory</key>
    <string>/absolute/path/to/teely</string>

    <key>StandardOutPath</key>
    <string>/tmp/teely.stdout.log</string>

    <key>StandardErrorPath</key>
    <string>/tmp/teely.stderr.log</string>
  </dict>
</plist>
